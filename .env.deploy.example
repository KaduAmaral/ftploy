# Copie para .env.deploy na raiz do projeto (não commite este arquivo com senha).
# Uso, depois de instalar o comando:
#   ftploy          # só arquivos alterados desde o último deploy
#   ftploy --full   # todos os arquivos que não estão excluídos

# --- FTP ---
FTP_HOST=ftp.example.com
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_PATH=/public_html
FTP_PORT=21
FTP_SSL=0

# --- Projeto ---
# DEPLOY_ROOT=                 # default: raiz do git do diretório atual
# DEPLOY_INFO=.deploy-info.json
# DEPLOY_EXCLUDE=".git .env .env.* vendor node_modules tmp tests"
# DEPLOY_PUBLISH="config/production.ini=>config/application.ini"
# DEPLOY_REQUIRE="index.php"
